\frac{Dk}{Dt} & =\nabla\cdot K_{q}\nabla k & + & \nu_{t}\nabla\mathbf{u}:\nabla\mathbf{u} & - & \frac{\nu_{t}}{\sigma_{k}}\frac{1}{\theta_{0}}\mathbf{g}\cdot\nabla\theta & - & \varepsilon\\
\frac{D\varepsilon}{Dt} & =\nabla\cdot K_{\varepsilon}\nabla\varepsilon & + & c_{1}\frac{\varepsilon}{k}\nu_{t}\nabla\mathbf{u}:\nabla\mathbf{u} & - & c_{3}\frac{\nu_{t}}{\sigma_{k}}\frac{1}{\theta_{0}}\mathbf{g}\cdot\nabla\theta & - & c_{2}\frac{\varepsilon^{2}}{k}
\end{align*}

