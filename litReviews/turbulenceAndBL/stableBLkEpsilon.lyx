\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\partial k}{\partial t}+\mathbf{u}\cdot\nabla k & =T_{k} & + & S_{k} & + & B_{k} & - & \varepsilon\\
 & =\nabla\cdot\frac{\nu_{t}}{\sigma_{k}}\nabla k & + & \nu_{t}\nabla\mathbf{u}:\nabla\mathbf{u} & + & \frac{\nu_{t}}{\sigma_{k}}\beta\mathbf{g}\cdot\nabla T & - & \varepsilon & \text{Henkes et al}\\
 &  &  &  & - & c_{\mu}\frac{k^{2}}{\varepsilon}\frac{\mathbf{g}\cdot\nabla\rho}{\rho} &  &  & \text{OpenFOAM}\\
\frac{\partial\varepsilon}{\partial t}+\mathbf{u}\cdot\nabla\varepsilon & =\nabla\cdot\frac{\nu_{t}}{\sigma_{\varepsilon}}\nabla\varepsilon & + & \frac{\varepsilon}{k}c_{1}f_{1}S_{k} & + & \frac{\varepsilon}{k}c_{1\varepsilon}f_{1}c_{3g}B_{k} & -\frac{\varepsilon}{k} & c_{1\varepsilon}f_{1}c_{2}f_{2}\varepsilon & \text{Henkes et al}\\
 & =\nabla\cdot\frac{\nu_{t}}{\sigma_{\varepsilon}}\nabla\varepsilon & + & \frac{\varepsilon}{k}c_{1}S_{k} & + & c_{3g}\frac{\varepsilon}{k}B_{k} & -\frac{\varepsilon}{k} & c_{2}\varepsilon & \text{OpenFOAM}\\
\nu_{t} & =c_{\mu}k^{2}/\varepsilon &  &  & c_{3g} & =\tanh\left|w/\left|\mathbf{v}_{h}\right|\right|
\end{align*}

\end_inset


\end_layout

