\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\partial\varepsilon}{\partial t}+\mathbf{u}\cdot\nabla\varepsilon & =\nabla\cdot\frac{\nu_{t}}{\sigma_{\varepsilon}}\nabla\varepsilon & + & \frac{\varepsilon}{k}c_{1\varepsilon}S_{k} & + & c_{3g}\frac{\varepsilon}{k}B_{k}+C_{4}\min\left(1,\sqrt{\frac{R_{i}}{C_{5}}}\right)N\varepsilon & -\frac{\varepsilon}{k} & c_{2}\varepsilon
\end{align*}

\end_inset


\end_layout

\begin_layout Section*
Boundary Conditions (Wall Functions)
\end_layout

\begin_layout Standard
The boundary conditions of the Cuxart et al case are:
\begin_inset Formula 
\begin{align}
\frac{\partial u}{\partial z} & =\frac{u_{*}}{\kappa z}\left(1+\beta_{m}\frac{z}{L}\right)\label{eq:uBC}\\
\frac{\partial\theta}{\partial z} & =\frac{\theta_{*}}{\kappa z}\left(1+\beta_{h}\frac{z}{L}\right)\label{eq:thetaBC}
\end{align}

\end_inset

with 
\begin_inset Formula $\beta_{m}=4.8$
\end_inset

,
 
\begin_inset Formula $\beta_{h}=7.8$
\end_inset

,
 
\begin_inset Formula $g=9.81$
\end_inset

,
 
\begin_inset Formula $\kappa=0.4$
\end_inset

 is von-Karmen's constant,
 
\begin_inset Formula $\theta_{0}=263.5\text{ K}$
\end_inset

 and 
\begin_inset Formula $L$
\end_inset

 is the Monin-Obukhov length
\begin_inset Formula 
\begin{equation}
L=\frac{\theta_{0}u_{*}^{2}}{g\theta_{*}\kappa}.
\end{equation}

\end_inset

Integrating (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:uBC"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:thetaBC"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) these gives
\begin_inset Formula 
\begin{align}
u_{z} & =\frac{u_{*}}{\kappa}\left(\ln\frac{z}{z_{0}}+\beta_{m}\frac{z}{L}\right)\label{eq:uz}\\
\Delta\theta_{z} & =\frac{\theta_{*}}{\kappa}\left(\ln\frac{z}{z_{0}}+\beta_{h}\frac{z}{L}\right)\label{eq:thetaz}
\end{align}

\end_inset

(
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:uz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:thetaz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) give us equations to calculate 
\begin_inset Formula $u_{*}$
\end_inset

 and 
\begin_inset Formula $\theta_{*}$
\end_inset

:
\begin_inset Formula 
\begin{align}
u_{*} & =\frac{\kappa u_{z}}{\ln\frac{z}{z_{0}}+\beta_{m}\frac{z}{L}}\label{eq:us}\\
\theta_{*} & =\frac{\kappa\Delta\theta_{z}}{\ln\frac{z}{z_{0}}+\beta_{h}\frac{z}{L}}.\label{eq:thetas}
\end{align}

\end_inset

The friction velocity,
 
\begin_inset Formula $u_{*}$
\end_inset

 is related to the wall shear stress and 
\begin_inset Formula $\theta_{*}$
\end_inset

 is related to the wall heat flux:
\begin_inset Formula 
\begin{align}
u_{*}^{2} & =\nu\frac{\partial u}{\partial z}=\nu_{t}\frac{\Delta u}{z}\label{eq:wallShear}\\
u_{*}\theta_{*}= & \alpha\frac{\partial\theta}{\partial z}=\alpha_{t}\frac{\Delta\theta}{z}.\label{eq:wallHeatFlux}
\end{align}

\end_inset

Combining (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:uz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wallShear"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:thetaz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wallHeatFlux"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) gives
\begin_inset Formula 
\begin{align}
u_{*}^{2} & =\nu_{t}\frac{\frac{u_{*}}{\kappa}\left(\ln\frac{z}{z_{0}}+\beta_{m}\frac{z}{L}\right)}{z}\implies & \nu_{t} & =\frac{u_{*}\kappa z}{\ln\frac{z}{z_{0}}+\beta_{m}\frac{z}{L}}\\
\alpha_{t} & =\frac{u_{*}z}{\Delta\theta_{z}}\frac{\kappa\Delta\theta_{z}}{\ln\frac{z}{z_{0}}+\beta_{h}\frac{z}{L}}\implies & \alpha_{t} & =\nu_{t}\frac{\ln\frac{z}{z_{0}}+\beta_{m}\frac{z}{L}}{\ln\frac{z}{z_{0}}+\beta_{h}\frac{z}{L}}
\end{align}

\end_inset

whereas in OpenFOAM
\begin_inset Formula 
\begin{align}
u_{*} & =C_{\mu}^{\frac{1}{4}}k^{\frac{1}{2}} & \nu_{t} & =\frac{\nu y_{+}\kappa}{\ln\left(Ey_{+}\right)}=\frac{u_{*}\kappa z}{\ln\left(Eu_{*}z/\nu\right)}\\
\alpha_{t} & =\nu_{t}/\text{Pr}_{t} & \varepsilon & =\frac{C_{\mu}^{\frac{3}{4}}k^{\frac{3}{2}}}{\kappa z}=\frac{u_{*}^{3}}{\kappa z}
\end{align}

\end_inset

In OpenFOAM,
 for large 
\begin_inset Formula $y_{+}$
\end_inset

,
 
\begin_inset Formula $z_{0}=C_{s}K_{s}/E$
\end_inset

 so set 
\begin_inset Formula $C_{s}=E=1$
\end_inset

,
 
\begin_inset Formula $K_{s}=z_{0}$
\end_inset

.
\begin_inset Formula 
\begin{equation}
y_{+}=\max\left(u_{*}y/\nu,\ e/E\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Boundary Condition for 
\begin_inset Formula $\varepsilon$
\end_inset


\end_layout

\begin_layout Standard
Somrath says
\begin_inset Formula 
\begin{equation}
\varepsilon=u_{*}^{3}\left(\frac{1+\beta_{m}\frac{z}{L}}{\kappa z}-\frac{1}{\kappa L}\right)=u_{*}^{3}\left(\frac{1}{\kappa z}+\frac{\beta_{m}}{\kappa L}-\frac{1}{\kappa L}\right)=\frac{u_{*}^{3}}{\kappa}\left(\frac{1}{z}+\frac{\beta_{m}-1}{L}\right).
\end{equation}

\end_inset

Make this into a correction
\begin_inset Formula 
\begin{equation}
\varepsilon=\frac{C_{\mu}^{\frac{3}{4}}k^{\frac{3}{2}}}{\kappa z}\left(1+\frac{z}{L}\left(\beta_{m}-1\right)\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
cite{ZWM20}
\end_layout

\end_inset

 Boundary Conditions
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
k=u_{*}^{2}/\sqrt{C_{\mu}},\  & \varepsilon=\frac{u_{*}^{3}}{\kappa}\left(\frac{1}{z_{0}}+\frac{\beta}{L}\right)
\end{align}

\end_inset

where 
\begin_inset Formula $\beta=4.7$
\end_inset

.
 These give
\begin_inset Formula 
\begin{equation}
\nu_{t}=C_{\mu}\frac{k^{2}}{\varepsilon}=\frac{u_{*}\kappa z_{0}}{1+\beta z_{0}/L}
\end{equation}

\end_inset

at the wall.
\end_layout

\begin_layout Subsubsection*
Modifications for OpenFOAM Boundary Conditions
\end_layout

\begin_layout Standard
\begin_inset Formula $k$
\end_inset

 remains zero gradient.
\begin_inset Formula 
\begin{align*}
\varepsilon & =\frac{C_{\mu}^{\frac{3}{4}}k^{\frac{3}{2}}}{\kappa z}\left(1+\frac{z}{L}\left(\beta_{m}-1\right)\right)\\
\nu_{t} & =\frac{u_{*}\kappa z}{\ln\frac{z}{z_{0}}+\beta_{m}\frac{z}{L}}\\
u_{*} & =C_{\mu}^{\frac{1}{4}}k^{\frac{1}{2}}\\
\theta_{*} & =\frac{\kappa\Delta\theta_{z}}{\ln\frac{z}{z_{0}}+\beta_{h}\frac{z}{L}}.\\
L & =\frac{\theta_{0}u_{*}^{2}}{g\theta_{*}\kappa}
\end{align*}

\end_inset


