\begin_layout Standard
\begin_inset Formula 
\begin{alignat}{4}
\frac{\partial k}{\partial t} & =S & + & B & + & T & - & D\\
 & =-\overline{u^{\prime}w^{\prime}}\frac{\partial u}{\partial z}-\overline{v^{\prime}w^{\prime}}\frac{\partial v}{\partial z} & + & \frac{g}{\theta_{\text{ref}}}\overline{w^{\prime}\theta^{\prime}} & - & \frac{\partial\overline{w^{\prime}k}}{\partial z} & - & c_{\varepsilon}\frac{k^{2/2}}{\ell_{\varepsilon}}\\
 & =K_{m}\left[\left(\frac{\partial u}{\partial z}\right)^{2}+\left(\frac{\partial v}{\partial z}\right)^{2}\right] & - & \frac{g}{\theta_{\text{ref}}}K_{h}\frac{\partial\theta}{\partial z} & + & \frac{\partial}{\partial z}\left(K_{k}\frac{\partial k}{\partial z}\right) & - & \varepsilon\\
K_{m} & =c_{m}\frac{k^{2}}{\varepsilon}f_{m} & K_{h} & =c_{h}\frac{k^{2}}{\varepsilon}f_{h}
\end{alignat}

\end_inset


\end_layout

\begin_layout Subsubsection*
Somrath Kanoksirirath
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\partial\varepsilon}{\partial t} & =-\frac{\partial\overline{w^{\prime}\varepsilon}}{\partial z} & +\frac{\varepsilon}{k} & \left(c_{1}S+c_{2}B+c_{3}T-c_{4}\varepsilon\right)\\
 & =\frac{\partial}{\partial z}\left(c_{\varepsilon}K_{m}\frac{\partial\varepsilon}{\partial z}\right) & +\frac{\varepsilon}{k} & \left(1.75S+\left(0.5+\frac{B}{\varepsilon}\right)B-2\varepsilon\right) & \text{Wyngaard (1975)}\\
 & =\frac{\partial}{\partial z}\left(c_{\varepsilon}K_{m}\frac{\partial\varepsilon}{\partial z}\right) & +\frac{\varepsilon}{k} & \left(1.46S+1.46\max\left(B,0\right)+1.45\max\left(T,0\right)-1.83\varepsilon\right) & \text{Duynkerke (1988)}\\
 & =\frac{\partial}{\partial z}\left(c_{\varepsilon}K_{m}\frac{\partial\varepsilon}{\partial z}\right) & +\frac{\varepsilon}{k} & \left(1.44S+1.44\times0.09B-1.92\varepsilon\right) & \text{Fu et al (2016)}
\end{align*}

\end_inset


\end_layout

